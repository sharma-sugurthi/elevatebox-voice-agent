# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini                  # gemini | groq
GEMINI_API_KEY=xxx
GROQ_API_KEY=xxx                     # only needed if LLM_PROVIDER=groq

# ── Vapi (telephony + voice) ──────────────────────────────────────────────────
VAPI_API_KEY=xxx
VAPI_PHONE_NUMBER_ID=xxx             # the imported Twilio number id in Vapi

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────────────────────
WHATSAPP_TOKEN=xxx                   # permanent system-user token
WHATSAPP_PHONE_NUMBER_ID=xxx         # registered business number id (NOT test number)
WHATSAPP_HOTLEAD_TEMPLATE=hot_lead_followup
WHATSAPP_POSTCALL_TEMPLATE=post_call_summary

# ── App ───────────────────────────────────────────────────────────────────────
EVALUATOR_PHONE=+918688664337        # the number the system must call
MY_PHONE=+91xxxxxxxxxx               # developer's number — goes in WhatsApp messages
PUBLIC_BASE_URL=https://your-app.herokuapp.com   # Heroku URL (no trailing slash)
