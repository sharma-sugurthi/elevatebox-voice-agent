# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini                  # gemini | groq

# Option A: Direct Gemini API (free tier)
GEMINI_API_KEY=xxx

# Option B: Vertex AI (GCP). If set, overrides GEMINI_API_KEY and forces LLM_PROVIDER=gemini.
# Paste the full contents of your GCP service account JSON as a single-line string.
GOOGLE_CREDENTIALS_JSON=

# Groq fallback (Llama 3.3 70B) — only needed if LLM_PROVIDER=groq
GROQ_API_KEY=xxx

# ── Database (Turso Edge SQLite) ──────────────────────────────────────────────
# Required for persistent call state and frontend real-time dashboard.
# Get both from: https://turso.tech/app
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=xxx

# ── Vapi (telephony + voice) ──────────────────────────────────────────────────
# Optional. Without these, /call/trigger is disabled. Brain still works via inbound.
VAPI_API_KEY=xxx
VAPI_PHONE_NUMBER_ID=xxx             # the imported Twilio number id in Vapi

# ── Plivo (telephony outbound) ────────────────────────────────────────────────
# Optional. Used for outbound calling instead of Vapi directly.
PLIVO_AUTH_ID=xxx
PLIVO_AUTH_TOKEN=xxx
PLIVO_FROM_NUMBER=+14155551234

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────────────────────
# Optional. Without these, WhatsApp sends are silently skipped.
WHATSAPP_TOKEN=xxx                   # permanent system-user token
WHATSAPP_PHONE_NUMBER_ID=xxx         # registered business number id (NOT the test number)
WHATSAPP_HOTLEAD_TEMPLATE=hot_lead_followup
WHATSAPP_POSTCALL_TEMPLATE=post_call_summary

# ── App ───────────────────────────────────────────────────────────────────────
EVALUATOR_PHONE=+91xxxxxxxxxx        # the number that receives WhatsApp notifications
MY_PHONE=+91xxxxxxxxxx               # developer number shown in post-call summary
PUBLIC_BASE_URL=https://your-app.herokuapp.com   # Heroku URL, no trailing slash
